{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Enfoque",
  "version": "0.1.0",
  "identifier": "dev.beatrizantolin.enfoque",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Enfoque",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "popover",
        "title": "Enfoque",
        "url": "popover.html",
        "width": 336,
        "height": 460,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:enfoque.db"]
    }
  }
}
